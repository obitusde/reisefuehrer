{
  "_hinweis": "Alle Stellschrauben der App. min_sterne/max_sterne je Typ begrenzen die Sterne (z. B. Museen immer mindestens ★). Startwerte, nach Goldliste in diag.html anpassen. Diese Datei darf direkt auf github.com bearbeitet werden. Achtung: gültiges JSON (Kommas, Anführungszeichen).",

  "wikipedia": {
    "sprachen": ["de", "en"],
    "limit": 500
  },

  "suche": {
    "ausblenden_typen": ["siedlung", "viertel"],
    "frage_details": true,
    "_hinweis_frage": "v0.9.4: Ab dem Zoom, bei dem „Hier suchen“ möglich ist (max_halbdiagonale_m), fragt eine Zeile über der Karte „Details laden?“ (Laden / ✕). false = nie fragen.",
    "_hinweis": "v0.5: „Hier suchen“ sucht im sichtbaren Kartenausschnitt. Ist der Ausschnitt größer (halbe Diagonale in Metern), kommt der Hinweis „näher heranzoomen“. Wikipedia erlaubt höchstens 10 000 m.",
    "max_halbdiagonale_m": 10000,
    "standort_zoom": 14
  },

  "gebiet": {
    "_hinweis": "v0.6: Gebiet vorbereiten. max_km2 = größte Fläche, zelle_m = Kantenlänge der Teilbereiche für Wikipedia, texte_ab_sternen/artikel_ab_sternen = für welche Orte Kurzinfo und Artikel vorab geladen werden, veraltet_tage = ab wann „aktualisieren“ empfohlen wird.",
    "max_km2": 400,
    "zelle_m": 3000,
    "texte_ab_sternen": 1,
    "artikel_ab_sternen": 1,
    "veraltet_tage": 30
  },

  "score": {
    "gewichte": {
      "sprachversionen": 3.0,
      "artikellaenge": 0.5
    },
    "quellen_bonus": 0.5,
    "denkmal_bonus": { "unesco": 3, "hoechste": 2, "denkmal": 1 },
    "denkmal_hoechste_qids": ["Q15700818", "Q10387684", "Q8274529"],
    "unesco_qids": ["Q9259"],
    "schwellen": { "3": 8, "2": 6, "1": 4 }
  },

  "sterne_text": {
    "3": "Lohnt die Reise",
    "2": "Lohnt einen Umweg",
    "1": "Interessant, wenn du in der Nähe bist",
    "0": "Ohne Stern"
  },
  "dauer_min": { "3": 90, "2": 60, "1": 30, "0": 0 },
  "dauer_text": { "3": "ab 1,5 Std.", "2": "ca. 1 Std.", "1": "ca. 30 Min.", "0": "" },

  "google": {
    "_hinweis": "v0.13.0: Knöpfe im Ortsfenster für Orte ohne Beschreibung. Die App gibt nur die Frage weiter (Fenster zum Schließen), die Antwort liest sie nicht. frage: {name} und {ort} werden ersetzt; auftrag steht dahinter. ki_param: Google-KI-Modus (nicht dokumentiert, kann sich ändern; leer = normale Suche mit der Frage). sprache: Oberflächen- und Antwortsprache.",
    "sprache": "de",
    "ki_param": "udm=50",
    "frage": "Was ist „{name}“{ort}?",
    "auftrag": "Keine Rückfrage am Ende"
  },

