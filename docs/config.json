  "osm": {
    "_hinweis": "OpenStreetMap über Overpass (PROJEKT.md 5d). Kacheln 0,05°, 30 Tage zwischengespeichert, höchstens 2 Anfragen gleichzeitig. max_wartezeit_s = so lange wartet die Suche höchstens (Knopf „Ohne OSM weiter“ geht immer), server_timeout_s = Zeit je Server. filter = Overpass-Bedingungen (nur Objekte mit Namen). typen = OSM-Tag → Typ aus „typen“ unten. Bei Änderungen an filter: version um 1 erhöhen (leert den Zwischenspeicher).",
    "aktiv": true,
    "version": 3,
    "server": ["https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter", "https://maps.mail.ru/osm/tools/overpass/api/interpreter"],
    "kachel_grad": 0.05,
    "max_wartezeit_s": 120,
    "vorbereiten_wartezeit_s": 600,
    "server_timeout_s": 40,
    "cache_tage": 30,
    "parallel": 2,
    "filter": [
      "[\"tourism\"~\"^(attraction|museum|gallery|viewpoint|artwork)$\"]",
      "[\"historic\"~\"^(castle|monument|memorial|ruins|archaeological_site|church|manor|city_gate|fort|tower|monastery|palace|bridge|ship|aircraft|locomotive|aqueduct|citywalls|mill|tomb|wreck)$\"][\"memorial\"!=\"plaque\"]",
      "[\"amenity\"~\"^(theatre|library|arts_centre)$\"]",
      "[\"leisure\"~\"^(park|garden)$\"]",
      "[\"natural\"~\"^(peak|waterfall)$\"]"
    ],
    "typen": {
      "tourism=museum": "museum", "tourism=gallery": "museum", "tourism=viewpoint": "aussicht", "tourism=artwork": "kunst",
      "tourism=attraction": "attraktion", "historic=castle": "burg", "historic=fort": "burg", "historic=palace": "palast",
      "historic=manor": "herrenhaus", "historic=monument": "denkmal", "historic=memorial": "denkmal", "historic=ruins": "archaeologie",
      "historic=archaeological_site": "archaeologie", "historic=church": "kirche", "historic=monastery": "kloster",
      "historic=city_gate": "denkmal", "historic=citywalls": "denkmal", "historic=tower": "turm", "historic=bridge": "bruecke",
      "historic=aqueduct": "bruecke", "historic=mill": "industrie", "historic=ship": "industrie", "historic=locomotive": "industrie",
      "historic=aircraft": "industrie", "historic=tomb": "denkmal", "historic=wreck": "archaeologie", "historic=*": "denkmal",
      "amenity=theatre": "theater", "amenity=library": "bibliothek", "amenity=arts_centre": "kunst",
      "leisure=park": "park", "leisure=garden": "park", "natural=peak": "natur", "natural=waterfall": "natur"
    },
    "ohne_wikidata": { "basis": 3, "max_sterne": 1 },
    "duplikat": { "aehnlichkeit": 0.85, "abstand_m": 150 }
  },

