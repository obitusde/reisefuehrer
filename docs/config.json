  "karten_app_standard": "google",
  "claude_uebergabe": "claude-new",

  "besucher": {
    "_hinweis": "Prompt für den Knopf „Lohnt sich das?“: Claude sucht Bewertungen und Erfahrungen von Besuchern im Netz und fasst sie zusammen.",
    "vorlage": [
      "Ich überlege, ob ich diese Sehenswürdigkeit besuchen soll.",
      "",
      "Ort: {name}",
      "Wo: {lat}, {lon}",
      "Art: {typ}",
      "Wikipedia: {wikipedia_url}",
      "",
      "Bitte suche im Internet nach aktuellen Bewertungen und Erfahrungen von Besuchern, zum Beispiel bei Google Maps, Tripadvisor und in Reiseforen oder Reiseblogs, und fasse alles zusammen:",
      "- Wie wird der Ort bewertet? Nenne je Quelle die Sterne und die Zahl der Bewertungen, wenn du sie findest.",
      "- Was loben Besucher am häufigsten, was kritisieren sie?",
      "- Lohnt sich ein Besuch? Für wen besonders, für wen eher nicht?",
      "- Praktische Tipps für den Besuch: beste Zeit, wie lange man braucht, Eintritt oder Tickets, Andrang, worauf man achten sollte.",
      "",
      "Regeln: Antworte auf Deutsch, kurz und so, dass man es gut vorlesen kann. Nenne bei Zahlen die Quelle. Wenn du nichts Aktuelles findest, sage das deutlich und erfinde nichts."
    ]
  },

  "erzaehlen": {
    "_hinweis": "Prompt für „Erzähl mir davon“ (PROJEKT.md Abschnitt 8). Platzhalter in {geschweiften Klammern}. claude_uebergabe oben: claude-new = Claude-App mit Text, kopieren-app = kopieren und Claude öffnen, kopieren = nur kopieren.",
    "max_zeichen": 12000,
    "quelltext_max": { "kurz": 2500, "normal": 3000, "ausfuehrlich": 10000 },
    "standard_ausfuehrlichkeit": "kurz",
    "laenge_text": {
      "kurz": "etwa dreißig Sekunden, ca. 80 Wörter, nur das Wichtigste",
      "normal": "etwa zwei Minuten, ca. 300 Wörter",
      "ausfuehrlich": "fünf Minuten oder länger, ca. 750 Wörter, mit Hintergründen und Geschichten"
    },
    "schwerpunkte": ["Geschichte", "Architektur", "Kunst", "Menschen und Geschichten", "Kurioses und Anekdoten"],
    "schwerpunkt_standard": "keiner, ein guter Überblick",
    "hinweis_gekuerzt": "an einer Satzgrenze gekürzt",
    "ohne_artikel": "(Zu diesem Ort gibt es keinen Wikipedia-Text. Sage das offen und erfinde nichts.)",
    "vorlage": [
      "Du bist mein Reiseführer. Erzähle mir gleich etwas über diesen Ort.",
      "",
      "Ort: {name}",
      "Wo: {lat}, {lon}{entfernung}",
      "Art: {typ}",
      "Länge: {laenge_text}",
      "Schwerpunkt: {schwerpunkt}",
      "",
      "Regeln:",
      "- Schreibe einen gesprochenen deutschen Text, ohne Listen, Überschriften und Formatierung, so, dass man ihn gut vorlesen kann.",
      "- Verwende nur Informationen aus dem Quelltext unten. Wenn etwas fehlt, sage es kurz. Erfinde nichts.",
      "- Schreibe Jahreszahlen so, wie man sie spricht, zum Beispiel neunzehnhundertzwölf statt 1912.",
      "- Beginne mit einem Satz, der mir hilft zu erkennen, was ich vor mir sehe.",
      "- Nenne am Ende keine Quellen.",
      "",
      "Quelltext ({quellsprache}, Wikipedia{gekuerzt}):",
      "{extrakt}",
      "",
      "Reisetipp (Wikivoyage): {wikivoyage}",
      "",
      "Weitere Infos: {wikipedia_url}"
    ]
  },

